# Template Konfigurasi Environment Pekarangan
# Salin file ini menjadi `.env.local` lalu isi dengan konfigurasi Anda.

# 1. Turso Database (SQLite Serverless - Disarankan: <50ms latency, free 5GB)
VITE_TURSO_DATABASE_URL=https://pekarangan-xxxx-yourname.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. Mamasar Integration API Endpoint (Jembatan Produk Pilar 4 / RPP)
VITE_MAMASAR_URL=https://mamasar.com/api/pekarangan/sync

# 3. Google Apps Script Web App (Opsional / Legacy fallback)
VITE_GAS_URL=https://script.google.com/macros/s/YOUR_GAS_DEPLOYMENT_ID/exec
