# Template Konfigurasi Environment Pekarangan
# Salin file ini menjadi `.env.local` lalu isi dengan URL Web App Anda sendiri.

# Google Apps Script Web App Deployment URL (Format: https://script.google.com/macros/s/.../exec)
VITE_GAS_URL=https://script.google.com/macros/s/YOUR_GAS_DEPLOYMENT_ID/exec
